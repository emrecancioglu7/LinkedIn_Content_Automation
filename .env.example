# Copy this file to .env. Never commit .env.
N8N_PORT=5678
POSTGRES_DB=linkedin_content
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Model choices are documented here for operators. The MVP workflows also have
# a visible Config node so model changes are reviewed rather than hidden.
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Telegram secrets are stored as Docker secret files under .secrets/.
# Run scripts/setup-telegram.sh instead of adding them here.
