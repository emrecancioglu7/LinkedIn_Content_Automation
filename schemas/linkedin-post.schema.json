{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LinkedInPostDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pillar": {
      "type": "string",
      "enum": [
        "OT_VERI_MIMARISI",
        "ENDUSTRIYEL_AI",
        "ENERJI_SURDURULEBILIRLIK",
        "URETIMDE_GENAI",
        "OT_SIBER_GUVENLIK",
        "TEKNIK_LIDERLIK"
      ]
    },
    "hook": { "type": "string" },
    "body": { "type": "string" },
    "cta": { "type": "string" },
    "hashtags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "evidence_id": { "type": "string" },
          "allowed": { "type": "boolean" },
          "reason": { "type": "string" }
        },
        "required": ["claim", "evidence_id", "allowed", "reason"]
      }
    },
    "image_brief": { "type": "string" },
    "image_title": { "type": "string", "maxLength": 64 },
    "image_points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 38 }
    },
    "visual_spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout_type": {
          "type": "string",
          "enum": ["process_flow", "layered_architecture", "comparison", "cause_effect", "cycle"]
        },
        "technical_title": { "type": "string", "maxLength": 42 },
        "international_name": { "type": "string", "maxLength": 48 },
        "curiosity_subtitle": { "type": "string", "maxLength": 92 },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 26 },
              "description": { "type": "string", "maxLength": 58 },
              "icon": {
                "type": "string",
                "enum": ["user", "identity", "shield", "lock", "network", "server", "database", "sensor", "plc", "ai", "energy", "analytics", "approval", "decision", "eye", "pulse", "cloud", "gateway"]
              },
              "state": { "type": "string", "enum": ["normal", "controlled", "risk", "outcome"] }
            },
            "required": ["label", "description", "icon", "state"]
          }
        },
        "connections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "integer", "minimum": 1, "maximum": 5 },
              "to": { "type": "integer", "minimum": 1, "maximum": 5 },
              "type": { "type": "string", "enum": ["flow", "allowed", "blocked", "conditional", "bidirectional"] }
            },
            "required": ["from", "to", "type"]
          }
        },
        "takeaways": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 24 },
              "description": { "type": "string", "maxLength": 46 },
              "icon": {
                "type": "string",
                "enum": ["user", "identity", "shield", "lock", "network", "server", "database", "sensor", "plc", "ai", "energy", "analytics", "approval", "decision", "eye", "pulse", "cloud", "gateway"]
              }
            },
            "required": ["label", "description", "icon"]
          }
        }
      },
      "required": ["layout_type", "technical_title", "international_name", "curiosity_subtitle", "stages", "connections", "takeaways"]
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "pillar",
    "hook",
    "body",
    "cta",
    "hashtags",
    "claims",
    "image_brief",
    "visual_spec",
    "risk_flags"
  ]
}
